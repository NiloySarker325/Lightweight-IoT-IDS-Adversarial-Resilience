print("\n--- Training PyTorch MLP Baseline ---")
# Set device for hardware acceleration
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')

# Convert pandas DataFrames/Series to PyTorch tensors
X_train_tensor = torch.tensor(X_train.values, dtype=torch.float32).to(device)
y_train_tensor = torch.tensor(y_train.values, dtype=torch.float32).unsqueeze(1).to(device)
X_test_tensor = torch.tensor(X_test.values, dtype=torch.float32).to(device)
y_test_tensor = torch.tensor(y_test.values, dtype=torch.float32).unsqueeze(1).to(device)

# Define a lightweight 3-layer MLP
class LightweightMLP(nn.Module):
    def __init__(self, input_dim):
        super(LightweightMLP, self).__init__()
        self.fc1 = nn.Linear(input_dim, 64)
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(64, 32)
        self.fc3 = nn.Linear(32, 1)
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        x = self.relu(self.fc1(x))
        x = self.relu(self.fc2(x))
        x = self.sigmoid(self.fc3(x))
        return x

# Initialize model, loss function, and optimizer
mlp_model = LightweightMLP(X_train.shape[1]).to(device)
criterion = nn.BCELoss()
optimizer = optim.Adam(mlp_model.parameters(), lr=0.001)

# Train the MLP
mlp_model.train()
for epoch in range(50):
    optimizer.zero_grad()
    outputs = mlp_model(X_train_tensor)
    loss = criterion(outputs, y_train_tensor)
    loss.backward()
    optimizer.step()

# Evaluate the MLP
mlp_model.eval()
start_time = time.time()
with torch.no_grad():
    mlp_preds = mlp_model(X_test_tensor)
    mlp_preds_class = (mlp_preds >= 0.5).float().cpu().numpy()
mlp_inference_time = time.time() - start_time

print(f"MLP Accuracy:  {accuracy_score(y_test, mlp_preds_class):.4f}")
print(f"MLP F1-Score:  {f1_score(y_test, mlp_preds_class):.4f}")
print(f"Inference Time (20k samples): {mlp_inference_time:.4f} seconds")



from art.estimators.classification import PyTorchClassifier
from art.attacks.evasion import FastGradientMethod
import numpy as np

print("\n==========================================")
print("Phase 3: White-Box Attack (FGSM on MLP)")
print("==========================================")

# Wrap the PyTorch model in ART's classifier API
art_classifier = PyTorchClassifier(
    model=mlp_model,
    clip_values=(0.0, 1.0), # Tabular constraints: keeps features constrained within our scaler limits
    loss=criterion,
    optimizer=optimizer,
    input_shape=(X_train.shape[1],),
    nb_classes=2,
    channels_first=False
)

# Initialize the Fast Gradient Sign Method (FGSM) attack
# 'eps' is the perturbation budget (the maximum amount the attacker can shift the features)
eps_value = 0.1
fgsm_attack = FastGradientMethod(estimator=art_classifier, eps=eps_value)

# I will attack a subset of the test data (first 5,000 samples) to ensure rapid generation
X_test_subset = X_test.values[:5000].astype(np.float32)
y_test_subset = y_test.values[:5000]

print(f"Generating adversarial network traffic with eps={eps_value}... (this might take a moment)")
# Generate the adversarial network flows
X_test_adv = fgsm_attack.generate(x=X_test_subset)

# Make predictions on the clean data vs. the adversarial data
clean_preds = (art_classifier.predict(X_test_subset) >= 0.5).astype(int).flatten()
adv_preds = (art_classifier.predict(X_test_adv) >= 0.5).astype(int).flatten()

# Calculate the drop in detection
clean_acc = accuracy_score(y_test_subset, clean_preds)
adv_acc = accuracy_score(y_test_subset, adv_preds)

print(f"Clean MLP Accuracy (on 5k subset):   {clean_acc:.4f}")
print(f"Adversarial MLP Accuracy (eps={eps_value}): {adv_acc:.4f}")
print(f"Accuracy Drop:                       {(clean_acc - adv_acc) * 100:.2f}%")




