import os
os.environ["PYTHONWARNINGS"] = "ignore"
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import MinMaxScaler



print("\n==========================================")
print("Phase 1: Initial setup")
print("==========================================")

# Pointing this to my MERGED_CSV folder 
folder_path = r'C:\Users\ERC\Downloads\MERGED_CSV'

print("Hunting for balanced data... this might take a minute.")

benign_data = pd.DataFrame()
malicious_data = pd.DataFrame()


# Loop through the files to collect enough of both classes
for file_name in os.listdir(folder_path):
    if file_name.endswith('.csv'):
        # Adding this print statement to see the progress
        print(f"Scanning {file_name}... (Current Benign: {len(benign_data)} / 50000)")
        
        df_temp = pd.read_csv(os.path.join(folder_path, file_name))
        
        # Separate benign and malicious traffic
        b_temp = df_temp[df_temp['Label'] == 'BENIGN']
        m_temp = df_temp[df_temp['Label'] != 'BENIGN']
        
        # Add to the running totals
        benign_data = pd.concat([benign_data, b_temp])
        malicious_data = pd.concat([malicious_data, m_temp])
        
        # Stop loading once it has at least 50,000 of each
        if len(benign_data) >= 50000 and len(malicious_data) >= 50000:
            print("Found enough data! Building the final subset...")
            break



# Take exactly 50,000 of each for a perfectly balanced 100k dataset
df_subset = pd.concat([
    benign_data.sample(n=50000, random_state=42),
    malicious_data.sample(n=50000, random_state=42)
])

# Shuffle the combined dataset so it is randomized
df_subset = df_subset.sample(frac=1, random_state=42).reset_index(drop=True)
print(f"Balanced Subset shape: {df_subset.shape}")

# Create the binary target column: 0 for Benign, 1 for Attack
df_subset['binary_label'] = df_subset['Label'].apply(lambda x: 0 if x == 'BENIGN' else 1)

print("\nClass Balance:")
print(df_subset['binary_label'].value_counts())

# Clean missing and infinite values
df_subset.replace([np.inf, -np.inf], np.nan, inplace=True)
df_subset.dropna(inplace=True)

# Separate features and targets
X = df_subset.drop(columns=['Label', 'binary_label'])
y = df_subset['binary_label']

# Scale the features
scaler = MinMaxScaler()
X_scaled = scaler.fit_transform(X)
X_scaled_df = pd.DataFrame(X_scaled, columns=X.columns)

# Split 80/20
X_train, X_test, y_train, y_test = train_test_split(X_scaled_df, y, test_size=0.2, random_state=42)

print(f"Training data shape: {X_train.shape}")
print(f"Testing data shape: {X_test.shape}")



import time
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, f1_score

# ==========================================
# Phase 2: Building Baseline Classifiers
# ==========================================

print("\n--- Training Decision Tree Baseline ---")
# Initialize the Decision Tree
dt_model = DecisionTreeClassifier(random_state=42)

# Train the model
dt_model.fit(X_train, y_train)

# Measure inference time for the test set
start_time = time.time()
dt_predictions = dt_model.predict(X_test)
dt_inference_time = time.time() - start_time

# Calculate clean metrics
dt_acc = accuracy_score(y_test, dt_predictions)
dt_f1 = f1_score(y_test, dt_predictions)

print(f"Decision Tree Accuracy:  {dt_acc:.4f}")
print(f"Decision Tree F1-Score:  {dt_f1:.4f}")
print(f"Inference Time (20k samples): {dt_inference_time:.4f} seconds")


print("\n--- Training Random Forest Baseline ---")
# Initialize the Random Forest (n_jobs=-1 uses all available CPU cores)
rf_model = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)

# Train the model
rf_model.fit(X_train.values, y_train)

# Measure inference time for the test set
start_time = time.time()
rf_predictions = rf_model.predict(X_test)
rf_inference_time = time.time() - start_time

# Calculate clean metrics
rf_acc = accuracy_score(y_test, rf_predictions)
rf_f1 = f1_score(y_test, rf_predictions)

print(f"Random Forest Accuracy:  {rf_acc:.4f}")
print(f"Random Forest F1-Score:  {rf_f1:.4f}")
print(f"Inference Time (20k samples): {rf_inference_time:.4f} seconds")




import xgboost as xgb
import torch
import torch.nn as nn
import torch.optim as optim
import time

print("\n--- Training XGBoost Baseline ---")
# Initialize XGBoost classifier
xgb_model = xgb.XGBClassifier(n_estimators=100, learning_rate=0.1, max_depth=3, random_state=42)

# Train the model
xgb_model.fit(X_train, y_train)

# Measure inference time for the test set
start_time = time.time()
xgb_predictions = xgb_model.predict(X_test)
